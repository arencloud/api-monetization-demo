FROM registry.access.redhat.com/ubi9/go-toolset:1.26.5 AS builder
WORKDIR /opt/app-root/src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ internal/
COPY applications/control/ applications/control/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /tmp/monetization-control ./applications/control

FROM registry.access.redhat.com/ubi9-micro:9.7
COPY --from=builder /tmp/monetization-control /usr/local/bin/monetization-control
USER 1001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/monetization-control"]
