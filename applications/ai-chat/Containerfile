FROM registry.access.redhat.com/ubi9/go-toolset:1.26.5 AS builder
WORKDIR /opt/app-root/src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ internal/
COPY applications/ai-chat/ applications/ai-chat/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /tmp/ai-chat-api ./applications/ai-chat

FROM registry.access.redhat.com/ubi9-micro:9.7
WORKDIR /opt/app-root/src
COPY --from=builder /tmp/ai-chat-api /usr/local/bin/ai-chat-api
COPY applications/ai-chat/openapi/ ./openapi/
USER 1001
EXPOSE 8080 8082
ENTRYPOINT ["/usr/local/bin/ai-chat-api"]
