{
  "name": "@arencloud/rhdh-monetization-backend",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "api-monetization",
    "pluginPackages": [
      "@arencloud/rhdh-monetization-backend"
    ]
  },
  "scalprum": {
    "name": "arencloud.rhdh-monetization-backend",
    "exposedModules": {
      "PluginRoot": "./src/index.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "export-dynamic": "rhdh-cli plugin export --shared-package @backstage-community/plugin-rbac-node",
    "package:dynamic": "node scripts/package-dynamic.mjs",
    "test": "backstage-cli package test",
    "tsc": "tsc"
  },
  "dependencies": {
    "@backstage-community/plugin-rbac-node": "^1.20.1",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1"
  },
  "peerDependencies": {
    "@backstage/backend-plugin-api": "^1.8.0",
    "@backstage/errors": "^1.2.7",
    "@backstage/plugin-permission-common": "^0.9.7",
    "@backstage/plugin-permission-node": "^0.10.11"
  },
  "bundledDependencies": [
    "express",
    "express-promise-router"
  ],
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.8.0",
    "@backstage/cli": "0.36.0",
    "@backstage/errors": "^1.2.7",
    "@backstage/plugin-permission-common": "^0.9.7",
    "@backstage/plugin-permission-node": "^0.10.11",
    "@red-hat-developer-hub/cli": "1.10.3",
    "@types/jest": "^29.5.14",
    "@types/express": "^4.17.21",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "dist-dynamic"
  ]
}
