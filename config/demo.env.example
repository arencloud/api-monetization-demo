# Public Git repository watched by the root Argo CD application.
GITOPS_REPO_URL=https://github.com/arencloud/api-monetization-demo.git
GITOPS_REVISION=main

# These values are consumed by later environment overlays and are documented
# now to establish a stable configuration contract.
BASE_DOMAIN=apps.example.com
API_HOSTNAME=api.apps.example.com
DEVELOPER_PORTAL_HOSTNAME=developer.apps.example.com
KEYCLOAK_HOSTNAME=sso.apps.example.com

# Never put credentials or API keys in this file.

